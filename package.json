{
  "name": "abbs-website",
  "version": "1.0.0",
  "description": "ABBS Website with API for waitlist and contact",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "npm start --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "vite build",
    "heroku-postbuild": "cd client && npm install && npm run build"
  },
  "dependencies": {
    "body-parser": "^1.20.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "pg": "^8.8.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^7.6.0",
    "nodemon": "^2.0.20",
    "vite": "^6.3.2"
  },
  "engines": {
    "node": "16.x"
  }
}
